DATABASE_URL=postgres://transmit:transmit@127.0.0.1:5432/transmit
COOKIE_SECURE=false

# Messaging (Telnyx). Leave unset to use the in-memory fake provider.
# MESSAGING_PROVIDER=telnyx|fake (default: telnyx when TELNYX_API_KEY is set)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=

# Set true to disable the in-process outbox worker (run scripts/worker.ts instead)
WORKER_DISABLED=false
