DATABASE_URL=postgres://transmit:transmit@127.0.0.1:5432/transmit
COOKIE_SECURE=false

# Public launch site. Analytics stays disabled until both values are set and a visitor consents.
PUBLIC_SITE_URL=https://kisocrm.com
PUBLIC_ANALYTICS_SCRIPT_URL=
PUBLIC_ANALYTICS_SITE_ID=

# Messaging + voice (Telnyx). Leave the API key unset to use in-memory fakes.
# MESSAGING_PROVIDER=telnyx|fake (default: telnyx when TELNYX_API_KEY is set)
# VOICE_PROVIDER=telnyx|fake (default: telnyx when TELNYX_API_KEY is set)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_VOICE_CONNECTION_ID=

# Configure the Voice API Application to POST v2 events to:
# https://your-public-host.example/api/v1/webhooks/telnyx

# Billing (Stripe). Leave the secret key unset to use the in-memory demo provider.
# BILLING_PROVIDER=stripe|fake (default: stripe when STRIPE_SECRET_KEY is set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LOCATION_PRICE_ID=
STRIPE_MESSAGE_PRICE_ID=
STRIPE_MESSAGE_METER_EVENT_NAME=

# AI drafting. Leave both keys unset to use deterministic local drafts.
# AI_PROVIDER=xai|anthropic|fake (default: xAI, then Anthropic, then fake based on available keys)
# AI_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_REASONING_EFFORT=low
# Enable Zero Data Retention in the xAI console, then confirm it here for production.
XAI_REQUIRE_ZDR=true
XAI_ZDR_CONFIRMED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Outbound customer webhooks use native fetch in development/production.
# Set to fake only for deterministic local automation.
# OUTBOUND_WEBHOOK_PROVIDER=fake

# Configure Stripe to POST subscription and invoice events to:
# https://your-public-host.example/api/v1/webhooks/stripe

# Transactional email (password resets) through transmit.dev, which speaks the
# Resend request shape. Leave the key unset to use the in-memory fake.
# EMAIL_PROVIDER=transmit|fake (default: transmit when TRANSMIT_API_KEY is set)
TRANSMIT_API_KEY=
TRANSMIT_API_BASE_URL=https://api.transmit.dev
EMAIL_FROM=Kiso CRM <hello@kisocrm.com>

# Set true to disable the in-process outbox worker (run scripts/worker.ts instead)
WORKER_DISABLED=false

# Production. With NODE_ENV=production the process refuses to start until every
# required variable is set, and refuses any *_PROVIDER=fake. See docs/DEPLOY.md.
# NODE_ENV=production
# ORIGIN=https://kisocrm.com
# PORT=3000
