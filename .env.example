DATABASE_URL=postgres://transmit:transmit@127.0.0.1:5432/transmit
# Cloud Run + Cloud SQL unix socket (empty host; encode @ # $ % in the password):
# DATABASE_URL=postgres://USER:PASSWORD@/kiso?host=/cloudsql/PROJECT:REGION:INSTANCE
COOKIE_SECURE=false

# Node adapter (`pnpm start` / `node build`). Vite loads `.env` in `pnpm dev`.
# Production web and worker load `.env` at runtime if the file is present; hosts
# can also inject the same names. Behind a tunnel or reverse proxy set ORIGIN
# to the public URL so Stripe Checkout and cookies see the external host.
# Production ORIGIN is the Cloud Run URL, not kisocrm.com, until the custom domain is mapped.
# ORIGIN=https://kiso-6upasqpfwq-uc.a.run.app
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=host
# PORT=3000

# Public launch site. Analytics stays disabled until both values are set and a visitor consents.
PUBLIC_SITE_URL=https://kisocrm.com
PUBLIC_ANALYTICS_SCRIPT_URL=
PUBLIC_ANALYTICS_SITE_ID=

# Messaging + voice (Telnyx). Leave the API key unset to use in-memory fakes.
# MESSAGING_PROVIDER=telnyx|fake (default: telnyx when TELNYX_API_KEY is set)
# VOICE_PROVIDER=telnyx|fake (default: telnyx when TELNYX_API_KEY is set)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
# Call Control connection id (not Application id if the UI shows both).
# Enable call_cost_in_webhooks=true on this Telnyx Call Control application for voice billing.
# Live Telnyx voice refuses to start unless that flag is enabled on this connection.
TELNYX_VOICE_CONNECTION_ID=

# Messaging profile and Call Control app both POST API v2 events to:
# https://kiso-6upasqpfwq-uc.a.run.app/api/v1/webhooks/telnyx
# 10DLC is in-app (brand + LOW_VOLUME campaign per workspace). Numbers are local,
# one per location, and are assigned to the campaign in code after approval.

# Billing (Stripe). Leave the secret key unset to use the in-memory demo provider.
# BILLING_PROVIDER=stripe|fake (default: stripe when STRIPE_SECRET_KEY is set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LOCATION_PRICE_ID=
# Metered Price on meter kiso_message. Per unit $0.02 USD (Stripe unit_amount=2).
# Do not use Graduated / first-250-free — Kiso reports only credits after the 250 included.
# Live Stripe refuses to start unless this Price is a USD metered per-unit 2-cent price.
STRIPE_MESSAGE_PRICE_ID=
# Must match the Stripe meter Event name exactly.
STRIPE_MESSAGE_METER_EVENT_NAME=kiso_message

# AI drafting. Leave both keys unset to use deterministic local drafts.
# AI_PROVIDER=xai|anthropic|fake (default: xAI, then Anthropic, then fake based on available keys)
# AI_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_REASONING_EFFORT=low
# Enable Zero Data Retention in the xAI console, then confirm it here for production.
XAI_REQUIRE_ZDR=true
XAI_ZDR_CONFIRMED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Conversational booking. The deterministic fake is refused in production.
# Leave unset/fake until a design-partner HTTPS scheduler exists; the concierge
# then reports that scheduling is not ready instead of inventing slots.
# SCHEDULER_PROVIDER=design_partner|fake
# The design-partner adapter requires an HTTPS base URL and bearer credential.
SCHEDULER_PROVIDER=fake
SCHEDULER_API_BASE_URL=
SCHEDULER_API_KEY=

# Outbound customer webhooks use native fetch in development/production.
# Set to fake only for deterministic local automation.
# OUTBOUND_WEBHOOK_PROVIDER=fake

# Stripe Checkout already sets a 14-day trial in code — do not also put a trial
# on the location price. Meter payload field must be stripe_customer_id.
# Webhook URL: https://your-public-host.example/api/v1/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# invoice.payment_failed.

# Set true to disable the in-process outbox worker (run scripts/worker.ts instead)
WORKER_DISABLED=false

# Optional dedicated browser-test database; default is DATABASE_URL database name plus _e2e.
# Create it before running Playwright. Never point it at a live-provider worker database.
# E2E_DATABASE_URL=postgres://transmit:transmit@127.0.0.1:5432/transmit_e2e
